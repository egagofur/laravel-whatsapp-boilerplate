APP_NAME="WhatsApp Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# WhatsApp Web sidecar (kstmostofa/laravel-whatsapp)
# ---------------------------------------------------------------------------
WHATSAPP_WEB_ENABLED=true
WHATSAPP_UI_CSS_MODE=standalone
WHATSAPP_UI_DEFAULT_SESSION=main
WHATSAPP_DRIVER=web
# SIDECAR_TOKEN=generate-a-long-random-string
# WHATSAPP_WEB_SESSION_DIR=
# PUPPETEER_EXECUTABLE_PATH=

# Meta Cloud API (only if WHATSAPP_DRIVER=cloud)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------
# API authentication — REQUIRED in production (fail-closed if empty)
# Generate strong unique values. Never commit real secrets to Git.
# ---------------------------------------------------------------------------
WHATSAPP_BASIC_AUTH_USER=admin
WHATSAPP_BASIC_AUTH_PASSWORD=changeme_in_production

N8N_BASIC_AUTH_USER=n8n_user
N8N_BASIC_AUTH_PASSWORD=changeme_in_production

# ---------------------------------------------------------------------------
# Outgoing n8n Webhook configuration
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_FORWARD_MESSAGE_CREATE=true
N8N_FORWARD_FROM_ME=false
N8N_CHAT_COOLDOWN_SECONDS=3

# ---------------------------------------------------------------------------
# Rate limits (requests per minute)
# ---------------------------------------------------------------------------
RATE_LIMIT_API=60
RATE_LIMIT_SEND=20
RATE_LIMIT_N8N=60

# Container / reverse proxy port
PORT=3001
